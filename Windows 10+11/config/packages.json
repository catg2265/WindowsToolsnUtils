{
  "packages": [
    {
      "name": "OpenJDK 17",
      "winget": "AdoptOpenJDK.OpenJDK.17",
      "choco": "temurin17jdk"
    },
    {
      "name": ".NET Runtime 7",
      "winget": "Microsoft.DotNet.Runtime.7",
      "choco": "dotnet-7.0-runtime",
      "override": "/quiet /norestart"
    },
    {
      "name": "Visual C++ Redistributable 2015-2022 x64",
      "winget": "Microsoft.VCRedist.2015+.x64",
      "choco": "vcredist140"
    },
    {
      "name": "Google Chrome",
      "winget": "Google.Chrome",
      "choco": "googlechrome",
      "fallback": {
        "url": "https://dl.google.com/chrome/install/standalonesetup64.exe",
        "silentArgs": "/silent /install"
      }
    },
    {
      "name": "VLC Media Player",
      "winget": "VideoLAN.VLC",
      "choco": "vlc"
    },
    {
      "name": "LibreOffice",
      "winget": "TheDocumentFoundation.LibreOffice",
      "choco": "libreoffice-fresh"
    }
  ]
}